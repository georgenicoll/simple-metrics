#!/usr/bin/env bash
# Thin wrapper around tofu that deploys simple-metrics (see deploy/) to one
# machine, chosen by naming its config first, so that day-to-day use is:
#
#   ./sms gorilla init
#   ./sms gorilla plan
#   ./sms gorilla apply
#   ./sms gorilla output
#   ./sms gorilla destroy
#
# Switching machine means changing one word:  ./sms chimp apply
#
# The first argument names the config: deploy/NAME.tfvars, copied from
# deploy/example.server.tfvars (private, not checked in). Each name's state is
# kept apart, beside its config, as deploy/NAME.tfstate, and lists what was
# deployed where. Everything after the command goes to tofu.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEPLOY_DIR="$REPO_DIR/deploy"

usage() {
    cat >&2 <<USAGE
Usage: ./sms <config> <tofu-command> [args...]

Configs: $(cd "$DEPLOY_DIR" && ls ./*.tfvars 2>/dev/null | sed 's#^\./##; s#\.tfvars$##; /^example\.server$/d' | tr '\n' ' ')

Examples:
  ./sms gorilla init
  ./sms gorilla plan
  ./sms gorilla apply
  ./sms gorilla output
  ./sms gorilla output -raw url
  ./sms gorilla destroy

The machine to deploy to is set in a config file, deploy/<config>.tfvars,
copied from deploy/example.server.tfvars.
USAGE
    exit 2
}

[[ $# -lt 2 ]] && usage

CONFIG_NAME="${1%.tfvars}"; shift
COMMAND="$1"; shift

command -v tofu >/dev/null 2>&1 || {
    echo "error: 'tofu' is not on PATH. See https://opentofu.org/docs/intro/install/" >&2
    exit 1
}

if [[ ! "$CONFIG_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "error: the first argument is a config name like 'gorilla' (for deploy/gorilla.tfvars), not '$CONFIG_NAME'" >&2
    usage
fi
CONFIG_PATH="$DEPLOY_DIR/$CONFIG_NAME.tfvars"

ARGS=()

# Commands that consume variables need the config file.
case "$COMMAND" in
plan | apply | destroy | refresh | import | console)
    if [[ ! -r "$CONFIG_PATH" ]]; then
        cat >&2 <<MSG
error: cannot read the config file: $CONFIG_PATH

Say which machine to deploy to, for example:
  cp deploy/example.server.tfvars deploy/$CONFIG_NAME.tfvars
  \$EDITOR deploy/$CONFIG_NAME.tfvars
MSG
        exit 1
    fi
    ARGS+=("-var-file=$CONFIG_PATH")
    ;;
esac

# State is kept per config name, beside its config, so that deploying a second
# machine (another config) never overwrites the first one's.
case "$COMMAND" in
plan | apply | destroy | refresh | import | output | show | state | taint | untaint)
    ARGS+=("-state=$DEPLOY_DIR/$CONFIG_NAME.tfstate")
    ;;
esac

set -x
exec tofu -chdir="$DEPLOY_DIR" "$COMMAND" "${ARGS[@]}" "$@"
