#!/usr/bin/env bash
# Thin wrapper around tofu that deploys simple-metrics (see deploy/) to one
# machine and injects the config file that says which, so that day-to-day use
# is:
#
#   ./sms init
#   ./sms plan
#   ./sms apply
#   ./sms output
#   ./sms destroy
#
# To deploy to a different machine, name its config with --config (anywhere on
# the command line):
#
#   ./sms plan  --config=gorilla      # deploy/gorilla.tfvars, gorilla.tfstate
#   ./sms apply --config=gorilla
#
# Without it the name is "server": deploy/server.tfvars and server.tfstate.
# The config (host, ssh user, image...) is private and not checked in: copy
# deploy/example.server.tfvars. Each name's state is kept apart, beside its
# config, and lists what was deployed where.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEPLOY_DIR="$REPO_DIR/deploy"

usage() {
    cat >&2 <<USAGE
Usage: ./sms <tofu-command> [args...]

Options:
  --config=NAME   use deploy/NAME.tfvars and keep its state in NAME.tfstate
                  (default: server). Also accepted as: --config NAME

Examples:
  ./sms init
  ./sms plan
  ./sms apply
  ./sms output
  ./sms output -raw url
  ./sms destroy
  ./sms apply --config=gorilla

The machine to deploy to is set in a config file, deploy/NAME.tfvars (default
deploy/server.tfvars), copied from deploy/example.server.tfvars.
USAGE
    exit 2
}

# Take out our own --config option, wherever it is; the rest goes to tofu.
CONFIG_NAME="server"
REST=()
while [[ $# -gt 0 ]]; do
    case "$1" in
    --config=*) CONFIG_NAME="${1#--config=}" ;;
    --config)
        [[ $# -ge 2 ]] || { echo "error: --config needs a name, e.g. --config=gorilla" >&2; exit 2; }
        CONFIG_NAME="$2"
        shift
        ;;
    *) REST+=("$1") ;;
    esac
    shift
done
set -- ${REST[@]+"${REST[@]}"}

[[ $# -lt 1 ]] && usage

COMMAND="$1"; shift

command -v tofu >/dev/null 2>&1 || {
    echo "error: 'tofu' is not on PATH. See https://opentofu.org/docs/intro/install/" >&2
    exit 1
}

# Absolute, because -chdir changes how relative paths resolve.
CONFIG_NAME="${CONFIG_NAME%.tfvars}"
if [[ ! "$CONFIG_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "error: --config takes a plain name like 'gorilla' (for deploy/gorilla.tfvars), not '$CONFIG_NAME'" >&2
    exit 2
fi
CONFIG_PATH="$DEPLOY_DIR/$CONFIG_NAME.tfvars"

ARGS=()

# Commands that consume variables need the config file.
case "$COMMAND" in
plan | apply | destroy | refresh | import | console)
    if [[ ! -r "$CONFIG_PATH" ]]; then
        cat >&2 <<MSG
error: cannot read the config file: $CONFIG_PATH

Say which machine to deploy to, for example:
  cp deploy/example.server.tfvars deploy/$CONFIG_NAME.tfvars
  \$EDITOR deploy/$CONFIG_NAME.tfvars
MSG
        exit 1
    fi
    ARGS+=("-var-file=$CONFIG_PATH")
    ;;
esac

# State is kept per config name, beside its config, so that deploying a second
# machine (another config) never overwrites the first one's.
case "$COMMAND" in
plan | apply | destroy | refresh | import | output | show | state | taint | untaint)
    ARGS+=("-state=$DEPLOY_DIR/$CONFIG_NAME.tfstate")
    ;;
esac

set -x
exec tofu -chdir="$DEPLOY_DIR" "$COMMAND" "${ARGS[@]}" "$@"
